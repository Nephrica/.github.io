  border-radius: 12px;
  padding: 20px;
  margin-bottom: 25px;
  transition: 0.25s;
}

.publication-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 6px 18px rgba(75,46,131,0.15);
}

.publication-title {
  font-size: 1.3rem;
  color: var(--deep-purple);
